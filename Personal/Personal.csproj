<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CloudinaryDotNet" Version="1.29.1" />
    </ItemGroup>

    <ItemGroup>
      <Content Update="App_Data/site-settings.json" CopyToPublishDirectory="Never" />
      <Content Update="wwwroot/uploads/admin/**" CopyToPublishDirectory="Never" />
    </ItemGroup>

</Project>
