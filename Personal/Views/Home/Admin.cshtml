@model AdminViewModel

@{
    ViewData["Title"] = "Admin Setup";
    ViewData["HideSiteChrome"] = true;
    var cloudinaryTargetLabel = string.IsNullOrWhiteSpace(Model.CurrentCloudinaryFolder)
        ? "Cloudinary root"
        : $"Cloudinary / {Model.CurrentCloudinaryFolder}";
    var activeLibraryLabel = Model.CurrentLibrarySource == "cloudinary" ? cloudinaryTargetLabel : "Admin uploads";
    var totalSeriesPhotos = Model.FeaturedSeries.Sum(series => series.PhotoUrls.Count);
    var isDashboardPage = Model.CurrentAdminPage == "dashboard";
    var isSeriesPage = Model.CurrentAdminPage == "series";
    var isLandingPage = Model.CurrentAdminPage == "landing";
    var isLibraryPage = Model.CurrentAdminPage == "library";
    var windowTitle = Model.CurrentAdminPage switch
    {
        "series" => "Series Manager",
        "landing" => "Landing Settings",
        "library" => "Image Library",
        _ => "Studio Overview"
    };
}

<section class="admin-shell admin-control-room">
    <header class="admin-menubar" aria-label="Admin menu">
        <strong>NZO</strong>
        <nav class="top-bar__menus" aria-label="Studio menu">
            <a class="top-menu__item top-menu__item--active" href="/#home">Home</a>
            <div class="top-menu__group">
                <button class="top-menu__item" type="button" aria-haspopup="true" aria-expanded="false">Gallery</button>
                <div class="top-menu__dropdown" role="menu">
                    <a role="menuitem" href="/#gallery">Main Gallery</a>
                    <a role="menuitem" asp-action="Albums" asp-controller="Home">Albums / Series</a>
                    <a role="menuitem" href="/#archive">Archive</a>
                    <a role="menuitem" href="/#works">Works</a>
                </div>
            </div>
            <div class="top-menu__group">
                <button class="top-menu__item" type="button" aria-haspopup="true" aria-expanded="false">Go</button>
                <div class="top-menu__dropdown" role="menu">
                    <a role="menuitem" href="/#studio">Profile</a>
                    <a role="menuitem" href="/#contact">Contact</a>
                    <a role="menuitem" href="/#services">Services</a>
                    <a role="menuitem" href="/#gear">Gear</a>
                    <a role="menuitem" href="/#pricing">Pricing</a>
                    <a role="menuitem" href="/#credentials">Credentials</a>
                    <a role="menuitem" href="https://www.instagram.com/nzhoooo" target="_blank" rel="noopener noreferrer">Instagram @@nzhoooo</a>
                </div>
            </div>
            <div class="top-menu__group">
                <button class="top-menu__item" type="button" aria-haspopup="true" aria-expanded="false">Window</button>
                <div class="top-menu__dropdown" role="menu">
                    <a role="menuitem" href="/">Guest</a>
                    <a role="menuitem" asp-action="Admin" asp-controller="Home" asp-route-adminPage="dashboard" asp-route-librarySource="@Model.CurrentLibrarySource" asp-route-cloudinaryFolder="@Model.CurrentCloudinaryFolder">Admin</a>
                </div>
            </div>
            <a class="top-menu__item" asp-area="" asp-controller="Home" asp-action="Help">Help</a>
        </nav>
        <div class="admin-menubar__actions" aria-label="Admin actions">
            <span class="material-symbols-outlined" aria-hidden="true">search</span>
            <span class="material-symbols-outlined" aria-hidden="true">notifications</span>
            <span class="material-symbols-outlined" aria-hidden="true">settings</span>
        </div>
    </header>

    <div class="admin-room-layout">
        <aside class="admin-room-sidebar reveal" aria-label="Admin control room sidebar">
            <div class="admin-room-brand">
                <span class="admin-room-brand__mark">
                    <span class="material-symbols-outlined" aria-hidden="true">photo_camera</span>
                </span>
                <div>
                    <strong>NZO<br>Studio</strong>
                    <span>Admin Console</span>
                </div>
            </div>

            <nav class="admin-room-nav" aria-label="Admin sections">
                <a class="admin-room-nav__item @(isDashboardPage ? "admin-room-nav__item--active" : string.Empty)" asp-action="Admin" asp-controller="Home" asp-route-adminPage="dashboard" asp-route-librarySource="@Model.CurrentLibrarySource" asp-route-cloudinaryFolder="@Model.CurrentCloudinaryFolder">
                    <span class="material-symbols-outlined" aria-hidden="true">dashboard</span>
                    Dashboard
                </a>
                <a class="admin-room-nav__item @(isSeriesPage ? "admin-room-nav__item--active" : string.Empty)" asp-action="Admin" asp-controller="Home" asp-route-adminPage="series" asp-route-librarySource="@Model.CurrentLibrarySource" asp-route-cloudinaryFolder="@Model.CurrentCloudinaryFolder">
                    <span class="material-symbols-outlined" aria-hidden="true">collections_bookmark</span>
                    Series
                </a>
                <a class="admin-room-nav__item @(isLandingPage ? "admin-room-nav__item--active" : string.Empty)" asp-action="Admin" asp-controller="Home" asp-route-adminPage="landing" asp-route-librarySource="@Model.CurrentLibrarySource" asp-route-cloudinaryFolder="@Model.CurrentCloudinaryFolder">
                    <span class="material-symbols-outlined" aria-hidden="true">view_carousel</span>
                    Landing
                </a>
                <a class="admin-room-nav__item @(isLibraryPage ? "admin-room-nav__item--active" : string.Empty)" asp-action="Admin" asp-controller="Home" asp-route-adminPage="library" asp-route-librarySource="@Model.CurrentLibrarySource" asp-route-cloudinaryFolder="@Model.CurrentCloudinaryFolder">
                    <span class="material-symbols-outlined" aria-hidden="true">photo_library</span>
                    Library
                </a>
            </nav>

            <section class="admin-sidebar-panel" aria-labelledby="sidebar-settings-title">
                <h2 id="sidebar-settings-title">Working Settings</h2>
                <dl class="admin-sidebar-stats">
                    <div>
                        <dt>Library</dt>
                        <dd>@activeLibraryLabel</dd>
                    </div>
                    <div>
                        <dt>Series</dt>
                        <dd>@Model.FeaturedSeries.Count active</dd>
                    </div>
                    <div>
                        <dt>Series Photos</dt>
                        <dd>@totalSeriesPhotos assigned</dd>
                    </div>
                    <div>
                        <dt>Carousel</dt>
                        <dd>@Model.LandingCarouselImages.Count slides</dd>
                    </div>
                </dl>
            </section>

            <section class="admin-sidebar-panel" aria-label="Library source">
                <h2>Library Source</h2>
                <a class="admin-room-source @(Model.CurrentLibrarySource == "local" ? "admin-room-source--active" : string.Empty)" asp-action="Admin" asp-controller="Home" asp-route-adminPage="@Model.CurrentAdminPage" asp-route-librarySource="local">
                    <span class="material-symbols-outlined" aria-hidden="true">folder</span>
                    Admin uploads
                </a>
                <a class="admin-room-source @(Model.CurrentLibrarySource == "cloudinary" ? "admin-room-source--active" : string.Empty)" asp-action="Admin" asp-controller="Home" asp-route-adminPage="@Model.CurrentAdminPage" asp-route-librarySource="cloudinary">
                    <span class="material-symbols-outlined" aria-hidden="true">cloud_done</span>
                    Cloudinary
                </a>
                @if (Model.CurrentLibrarySource == "cloudinary")
                {
                    <div class="admin-room-folders" aria-label="Cloudinary folders">
                        @foreach (var folder in Model.CloudinaryFolders)
                        {
                            <a class="admin-room-folder @(Model.CurrentCloudinaryFolder == folder.Folder ? "admin-room-folder--active" : string.Empty)"
                               asp-action="Admin"
                               asp-controller="Home"
                               asp-route-adminPage="@Model.CurrentAdminPage"
                               asp-route-librarySource="cloudinary"
                               asp-route-cloudinaryFolder="@folder.Folder">
                                <span class="material-symbols-outlined" aria-hidden="true">@(folder.IsRoot ? "home_storage" : "folder_open")</span>
                                @folder.Name
                            </a>
                        }
                    </div>
                    <form class="admin-room-folder-form" asp-action="CreateCloudinaryFolder" asp-controller="Home" method="post">
                        <label for="admin-cloudinary-folder-name">New folder</label>
                        <div>
                            <input id="admin-cloudinary-folder-name" name="folderName" type="text" placeholder="folder name" autocomplete="off">
                            <button type="submit" aria-label="Create Cloudinary folder">
                                <span class="material-symbols-outlined" aria-hidden="true">create_new_folder</span>
                            </button>
                        </div>
                    </form>
                }
            </section>

            <form class="admin-sidebar-upload" asp-action="UploadImages" asp-controller="Home" method="post" enctype="multipart/form-data">
                <input type="hidden" name="librarySource" value="@Model.CurrentLibrarySource">
                <input type="hidden" name="cloudinaryFolder" value="@Model.CurrentCloudinaryFolder">
                <label>
                    <span class="material-symbols-outlined" aria-hidden="true">upload</span>
                    Upload Photo
                    <input type="file" name="images" accept="image/*" multiple required onchange="this.form.requestSubmit()">
                </label>
            </form>
        </aside>

        <main class="admin-room-main">
            <div class="admin-window reveal">
                <div class="admin-window__bar">
                    <span></span>
                    <span></span>
                    <span></span>
                    <strong>@windowTitle</strong>
                </div>
                <div class="admin-window__body">
                    <div class="admin-room-title" id="studio-overview">
                        <span class="label">Admin Console</span>
                        <h1>@windowTitle</h1>
                        <p>Manage the current public-site settings: series, landing carousel, image library, and upload destination.</p>
                    </div>

        @if (TempData["AdminMessage"] is string message)
        {
            <div class="admin-alert" role="status">@message</div>
        }

        @if (!isLibraryPage)
        {
        <div class="admin-grid">
            @if (isDashboardPage)
            {
            <article class="admin-card admin-card--wide reveal">
                <div class="admin-card__icon">
                    <span class="material-symbols-outlined" aria-hidden="true">settings</span>
                </div>
                <div>
                    <span class="label">Site Setup</span>
                    <h2>Studio configuration</h2>
                    <p>Keep the public site pointed at curated gallery content while we prepare the private upload and publishing workflow.</p>
                </div>
                <div class="setup-list" aria-label="Site setup status">
                    <div>
                        <span>Brand</span>
                        <strong>NZO</strong>
                    </div>
                    <div>
                        <span>Gallery Source</span>
                        <strong>Cloudinary ready</strong>
                    </div>
                    <div>
                        <span>Upload Flow</span>
                        <strong>Admin library</strong>
                    </div>
                </div>
            </article>
            }

            @if (isLandingPage)
            {
            <article class="admin-card admin-card--wide reveal" id="landing-settings">
                <div class="admin-card__icon admin-card__icon--soft">
                    <span class="material-symbols-outlined" aria-hidden="true">wallpaper</span>
                </div>
                <span class="label">Landing Page</span>
                <h2>Background image</h2>
                <p>The active landing page background is shown below. Pick any uploaded image to replace it.</p>
                <div class="current-background">
                    <img src="@Model.CurrentLandingBackground" alt="Current landing page background">
                </div>
            </article>

            <article class="admin-card admin-card--full reveal" id="landing-carousel">
                <div class="admin-card__icon admin-card__icon--blue">
                    <span class="material-symbols-outlined" aria-hidden="true">view_carousel</span>
                </div>
                <div>
                    <span class="label">Landing Page</span>
                    <h2>Current 4-image rotation</h2>
                    <p>These are the exact images visitors see on the landing page carousel, in order. The first image appears when the page loads, then it changes every 5 seconds.</p>
                </div>
                <div class="carousel-preview-grid" aria-label="Current landing page carousel images">
                    @for (var index = 0; index < Model.LandingCarouselImages.Count; index++)
                    {
                        var imageUrl = Model.LandingCarouselImages[index];
                        var isOpeningSlide = index == 0;
                        <figure class="carousel-preview-card">
                            <img src="@imageUrl" alt="Landing carousel slide @(index + 1)">
                            <figcaption>
                                <span>Slide @(index + 1)</span>
                                @if (isOpeningSlide)
                                {
                                    <strong>Opens first</strong>
                                }
                                else
                                {
                                    <strong>After @(index * 5)s</strong>
                                }
                            </figcaption>
                            <form class="carousel-slide-form" asp-action="SetCarouselSlide" asp-controller="Home" method="post">
                                <input type="hidden" name="slideIndex" value="@index">
                                <input type="hidden" name="librarySource" value="@Model.CurrentLibrarySource">
                                <input type="hidden" name="cloudinaryFolder" value="@Model.CurrentCloudinaryFolder">
                                <select name="imageUrl" aria-label="Image for slide @(index + 1)">
                                    @foreach (var option in Model.CarouselImageOptions)
                                    {
                                        if (option.Url == imageUrl)
                                        {
                                            <option value="@option.Url" selected>@option.DisplayName</option>
                                        }
                                        else
                                        {
                                            <option value="@option.Url">@option.DisplayName</option>
                                        }
                                    }
                                </select>
                                <button type="submit">Set slide</button>
                            </form>
                        </figure>
                    }
                </div>
            </article>
            }

            @if (isSeriesPage)
            {
            <article class="admin-card admin-card--full reveal">
                <div class="admin-card__icon admin-card__icon--blue">
                    <span class="material-symbols-outlined" aria-hidden="true">collections_bookmark</span>
                </div>
                <div>
                    <span class="label">Featured Series</span>
                    <h2>Series manager</h2>
                    <p>Edit featured series, add new groups, assign photos, and choose the cover image shown on the public gallery.</p>
                </div>

                <form class="series-create-form" asp-action="CreateFeaturedSeries" asp-controller="Home" method="post">
                    <input type="hidden" name="librarySource" value="@Model.CurrentLibrarySource">
                    <input type="hidden" name="cloudinaryFolder" value="@Model.CurrentCloudinaryFolder">
                    <div class="series-create-form__fields">
                        <label>
                            <span>Title</span>
                            <input name="title" type="text" placeholder="New series title" autocomplete="off" required>
                        </label>
                        <label>
                            <span>Orientation</span>
                            <select name="orientation">
                                <option value="landscape">Landscape</option>
                                <option value="portrait">Portrait</option>
                            </select>
                        </label>
                        <label>
                            <span>Cover</span>
                            <select name="coverImageUrl">
                                <option value="">Choose later</option>
                                @foreach (var option in Model.SeriesImageOptions)
                                {
                                    <option value="@option.Url">@option.DisplayName</option>
                                }
                            </select>
                        </label>
                    </div>
                    <label>
                        <span>Description</span>
                        <textarea name="description" rows="2" placeholder="Short description for this series"></textarea>
                    </label>
                    <button class="soft-button" type="submit">
                        Add series
                        <span class="material-symbols-outlined" aria-hidden="true">add</span>
                    </button>
                </form>

                <div class="featured-series-admin featured-series-finder" data-admin-series-finder>
                    <aside class="featured-series-finder__list" aria-label="Featured series">
                        @for (var index = 0; index < Model.FeaturedSeries.Count; index++)
                        {
                            var series = Model.FeaturedSeries[index];
                            var isSelected = index == 0;
                            <button class="featured-series-finder__item @(isSelected ? "featured-series-finder__item--active" : string.Empty)"
                                    type="button"
                                    data-admin-series-tab="@series.Id"
                                    aria-pressed="@isSelected.ToString().ToLowerInvariant()">
                                <img src="@series.CoverImageUrl" alt="">
                                <span>
                                    <strong>@series.Title</strong>
                                    <small>@series.Eyebrow · @series.Orientation · @series.PhotoUrls.Count photo@(series.PhotoUrls.Count == 1 ? string.Empty : "s")</small>
                                </span>
                            </button>
                        }
                    </aside>

                    <div class="featured-series-finder__detail">
                    @for (var index = 0; index < Model.FeaturedSeries.Count; index++)
                    {
                        var series = Model.FeaturedSeries[index];
                        var isSelected = index == 0;
                        <article class="featured-series-admin__card"
                                 data-admin-series-panel="@series.Id"
                                 hidden="@(!isSelected)">
                            <div class="featured-series-admin__cover">
                                <img src="@series.CoverImageUrl" alt="@series.Title cover">
                                <span>@series.Orientation</span>
                            </div>
                            <div class="featured-series-admin__body">
                                <form class="featured-series-admin__edit" asp-action="UpdateFeaturedSeries" asp-controller="Home" method="post">
                                    <input type="hidden" name="seriesId" value="@series.Id">
                                    <input type="hidden" name="librarySource" value="@Model.CurrentLibrarySource">
                                    <input type="hidden" name="cloudinaryFolder" value="@Model.CurrentCloudinaryFolder">
                                    <label>
                                        <span>Label</span>
                                        <input name="eyebrow" type="text" value="@series.Eyebrow">
                                    </label>
                                    <label>
                                        <span>Title</span>
                                        <input name="title" type="text" value="@series.Title" required>
                                    </label>
                                    <label>
                                        <span>Orientation</span>
                                        <select name="orientation">
                                            @if (series.Orientation == "landscape")
                                            {
                                                <option value="landscape" selected>Landscape</option>
                                                <option value="portrait">Portrait</option>
                                            }
                                            else
                                            {
                                                <option value="landscape">Landscape</option>
                                                <option value="portrait" selected>Portrait</option>
                                            }
                                        </select>
                                    </label>
                                    <label class="featured-series-admin__description">
                                        <span>Description</span>
                                        <textarea name="description" rows="3">@series.Description</textarea>
                                    </label>
                                    <button type="submit">Save series</button>
                                </form>

                                <div class="featured-series-admin__tools">
                                    <div class="featured-series-admin__tool-panel">
                                        <span>Cover image</span>
                                        <button type="button" data-series-cover-modal-open="@series.Id">Choose cover</button>
                                    </div>

                                    <div class="featured-series-admin__tool-panel">
                                        <span>Add pictures</span>
                                        <button type="button" data-series-photos-modal-open="@series.Id">Add pics</button>
                                    </div>

                                    <div class="featured-series-admin__tool-panel">
                                        <span>Added photos</span>
                                        <button type="button" data-series-added-photos-modal-open="@series.Id">View photos</button>
                                    </div>

                                    <form class="featured-series-admin__remove-series" asp-action="RemoveFeaturedSeries" asp-controller="Home" method="post" data-confirm="Remove this entire featured series?">
                                        <input type="hidden" name="seriesId" value="@series.Id">
                                        <input type="hidden" name="librarySource" value="@Model.CurrentLibrarySource">
                                        <input type="hidden" name="cloudinaryFolder" value="@Model.CurrentCloudinaryFolder">
                                        <button type="submit">Remove series</button>
                                    </form>
                                </div>

                                <div class="series-photos-modal" data-series-photos-modal="@series.Id" hidden>
                                    <div class="series-photos-modal__backdrop" data-series-photos-modal-close></div>
                                    <section class="series-photos-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="series-photos-title-@series.Id">
                                        <button class="series-photos-modal__close" type="button" aria-label="Close photo manager" data-series-photos-modal-close>
                                            <span class="material-symbols-outlined" aria-hidden="true">close</span>
                                        </button>
                                        <span class="label">Photos</span>
                                        <h3 id="series-photos-title-@series.Id">@series.Title</h3>
                                        <form class="series-photos-modal__library" asp-action="AddFeaturedSeriesPhoto" asp-controller="Home" method="post" data-series-photo-picker>
                                            <span>Add existing photos</span>
                                            <input type="hidden" name="seriesId" value="@series.Id">
                                            <input type="hidden" name="librarySource" value="@Model.CurrentLibrarySource">
                                            <input type="hidden" name="cloudinaryFolder" value="@Model.CurrentCloudinaryFolder">
                                            <label class="series-photos-modal__search">
                                                <span class="material-symbols-outlined" aria-hidden="true">search</span>
                                                <input type="search" placeholder="Search photos" data-series-photo-search>
                                            </label>
                                            <div class="series-photos-modal__library-grid">
                                                @foreach (var option in Model.SeriesImageOptions)
                                                {
                                                    var isAlreadyInSeries = series.PhotoUrls.Contains(option.Url, StringComparer.Ordinal);
                                                    <label class="series-photos-modal__library-choice @(isAlreadyInSeries ? "series-photos-modal__library-choice--added" : string.Empty)">
                                                        <input type="checkbox" name="imageUrl" value="@option.Url" disabled="@isAlreadyInSeries">
                                                        <span class="series-photos-modal__library-preview">
                                                            <img src="@option.Url" alt="@option.DisplayName">
                                                        </span>
                                                        <span>@option.DisplayName</span>
                                                        <strong>@(isAlreadyInSeries ? "Added" : "Select")</strong>
                                                    </label>
                                                }
                                            </div>
                                            <button class="series-photos-modal__add-selected" type="submit" hidden>Add selected photos</button>
                                        </form>
                                    </section>
                                </div>
                                <div class="series-added-photos-modal" data-series-added-photos-modal="@series.Id" hidden>
                                    <div class="series-added-photos-modal__backdrop" data-series-added-photos-modal-close></div>
                                    <section class="series-added-photos-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="series-added-photos-title-@series.Id">
                                        <button class="series-added-photos-modal__close" type="button" aria-label="Close added photos" data-series-added-photos-modal-close>
                                            <span class="material-symbols-outlined" aria-hidden="true">close</span>
                                        </button>
                                        <span class="label">Added Photos</span>
                                        <h3 id="series-added-photos-title-@series.Id">@series.Title</h3>
                                        @if (series.PhotoUrls.Count == 0)
                                        {
                                            <p data-series-added-photos-empty>No photos in this series yet.</p>
                                        }
                                        else
                                        {
                                            <div class="series-added-photos-modal__grid">
                                                @foreach (var photoUrl in series.PhotoUrls)
                                                {
                                                    var isManagedCover = photoUrl == series.CoverImageUrl;
                                                    <figure>
                                                        <img src="@photoUrl" alt="@series.Title photo">
                                                        <figcaption>
                                                            @if (isManagedCover)
                                                            {
                                                                <strong>Cover</strong>
                                                            }
                                                            <form asp-action="RemoveFeaturedSeriesPhoto" asp-controller="Home" method="post" data-confirm="Remove this photo from the series?">
                                                                <input type="hidden" name="seriesId" value="@series.Id">
                                                                <input type="hidden" name="imageUrl" value="@photoUrl">
                                                                <input type="hidden" name="librarySource" value="@Model.CurrentLibrarySource">
                                                                <input type="hidden" name="cloudinaryFolder" value="@Model.CurrentCloudinaryFolder">
                                                                <button class="series-added-photos-modal__remove" type="submit">Remove photo</button>
                                                            </form>
                                                        </figcaption>
                                                    </figure>
                                                }
                                            </div>
                                        }
                                    </section>
                                </div>
                                <div class="series-cover-modal" data-series-cover-modal="@series.Id" hidden>
                                    <div class="series-cover-modal__backdrop" data-series-cover-modal-close></div>
                                    <section class="series-cover-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="series-cover-title-@series.Id">
                                        <button class="series-cover-modal__close" type="button" aria-label="Close cover picker" data-series-cover-modal-close>
                                            <span class="material-symbols-outlined" aria-hidden="true">close</span>
                                        </button>
                                        <span class="label">Cover Image</span>
                                        <h3 id="series-cover-title-@series.Id">@series.Title</h3>
                                        @if (series.PhotoUrls.Count == 0)
                                        {
                                            <p>No photos in this series yet.</p>
                                        }
                                        else
                                        {
                                            <div class="series-cover-modal__grid">
                                                @foreach (var photoUrl in series.PhotoUrls)
                                                {
                                                    var isCoverChoice = photoUrl == series.CoverImageUrl;
                                                    <form asp-action="SetFeaturedSeriesCover" asp-controller="Home" method="post">
                                                        <input type="hidden" name="seriesId" value="@series.Id">
                                                        <input type="hidden" name="imageUrl" value="@photoUrl">
                                                        <input type="hidden" name="librarySource" value="@Model.CurrentLibrarySource">
                                                        <input type="hidden" name="cloudinaryFolder" value="@Model.CurrentCloudinaryFolder">
                                                        <button class="series-cover-modal__choice @(isCoverChoice ? "series-cover-modal__choice--active" : string.Empty)" type="submit">
                                                            <img src="@photoUrl" alt="@series.Title cover option">
                                                            <span>@(isCoverChoice ? "Current cover" : "Set cover")</span>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        }
                                    </section>
                                </div>
                            </div>
                        </article>
                    }
                    </div>
                </div>
            </article>
            }

        </div>
        }

        @if (isLibraryPage)
        {
        <section class="admin-library reveal" aria-labelledby="image-library-title">
            <div class="section-head">
                <div>
                    <h2 id="image-library-title">Image Library</h2>
                    <p>Uploaded images appear here. Select one to become the landing page background or assign it to a carousel slot.</p>
                </div>
            </div>

            <div class="finder-window">
                <div class="finder-window__bar" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
                <div class="finder-window__body finder-window__body--single">
                    @if (Model.UploadedImages.Count == 0)
                    {
                        <div class="empty-library">
                            <span class="material-symbols-outlined" aria-hidden="true">photo_library</span>
                            <p>No @(Model.CurrentLibrarySource == "cloudinary" ? "Cloudinary files" : "local admin uploads") yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="finder-list" role="table" aria-label="Uploaded images">
                            <div class="finder-list__head" role="row">
                                <span role="columnheader">Name</span>
                                <span role="columnheader">Source</span>
                                <span role="columnheader">Added</span>
                                <span role="columnheader">Actions</span>
                            </div>
                            @foreach (var image in Model.UploadedImages)
                            {
                                var isCurrent = image.Url == Model.CurrentLandingBackground;
                                var sourceLabel = image.Source == "cloudinary" ? "Cloudinary" : "Local";
                                <div class="finder-row" role="row">
                                    <div class="finder-row__name" role="cell">
                                        <img src="@image.Url" alt="@image.DisplayName">
                                        <span>@image.DisplayName</span>
                                    </div>
                                    <span role="cell">@sourceLabel</span>
                                    <span role="cell">@image.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                                    <div class="finder-row__actions" role="cell">
                                        @if (isCurrent)
                                        {
                                            <strong>Background</strong>
                                        }
                                        else
                                        {
                                            <form asp-action="SetLandingBackground" asp-controller="Home" method="post">
                                                <input type="hidden" name="imageUrl" value="@image.Url">
                                                <input type="hidden" name="librarySource" value="@Model.CurrentLibrarySource">
                                                <input type="hidden" name="cloudinaryFolder" value="@Model.CurrentCloudinaryFolder">
                                                <button type="submit">Background</button>
                                            </form>
                                        }
                                        @for (var index = 0; index < 4; index++)
                                        {
                                            var isSlide = Model.LandingCarouselImages.Count > index && Model.LandingCarouselImages[index] == image.Url;
                                            if (isSlide)
                                            {
                                                <strong>S@(index + 1)</strong>
                                            }
                                            else
                                            {
                                                <form asp-action="SetCarouselSlide" asp-controller="Home" method="post">
                                                    <input type="hidden" name="slideIndex" value="@index">
                                                    <input type="hidden" name="imageUrl" value="@image.Url">
                                                    <input type="hidden" name="librarySource" value="@Model.CurrentLibrarySource">
                                                    <input type="hidden" name="cloudinaryFolder" value="@Model.CurrentCloudinaryFolder">
                                                    <button type="submit">S@(index + 1)</button>
                                                </form>
                                            }
                                        }
                                        <form asp-action="RemoveUploadedImage" asp-controller="Home" method="post" data-confirm="Remove this image?">
                                            <input type="hidden" name="imageUrl" value="@image.Url">
                                            <input type="hidden" name="fileName" value="@image.FileName">
                                            <input type="hidden" name="librarySource" value="@Model.CurrentLibrarySource">
                                            <input type="hidden" name="cloudinaryFolder" value="@Model.CurrentCloudinaryFolder">
                                            <button class="finder-row__remove" type="submit">Remove</button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </section>
        }
                </div>
            </div>
        </main>
    </div>
</section>
