@{
    ViewData["Title"] = "Help";
}

<section class="help-shell">
    <div class="lumina-container">
        <div class="help-hero reveal">
            <span class="label">Help</span>
            <h1>Navigation guide.</h1>
            <p>Use the top menu to move through NZO, browse gallery sections, find contact details, or open the temporary admin gate.</p>
        </div>

        <div class="help-grid">
            <article class="help-card reveal">
                <span class="material-symbols-outlined" aria-hidden="true">home</span>
                <h2>Home</h2>
                <p>Returns to the landing page and current hero carousel.</p>
            </article>
            <article class="help-card reveal">
                <span class="material-symbols-outlined" aria-hidden="true">photo_library</span>
                <h2>Gallery</h2>
                <p>Use Gallery for main work, featured series, archive links, and future works sections.</p>
            </article>
            <article class="help-card reveal">
                <span class="material-symbols-outlined" aria-hidden="true">near_me</span>
                <h2>Go</h2>
                <p>Jump to profile, contact, Instagram, services, gear, pricing, and credentials.</p>
            </article>
            <article class="help-card reveal">
                <span class="material-symbols-outlined" aria-hidden="true">admin_panel_settings</span>
                <h2>Admin</h2>
                <p>Open Window, choose Admin, then enter the temporary password to manage uploads and carousel settings.</p>
            </article>
        </div>
    </div>
</section>
