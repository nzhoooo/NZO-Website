@model HomeViewModel

@{
    ViewData["Title"] = "NZO";
    var landingImages = Model.LandingCarouselImages.Count > 0
        ? Model.LandingCarouselImages
        : new[] { "/images/lumina/hero.jpg" };
    var seriesPageSize = 6;
    var initialSeriesEnd = Math.Min(seriesPageSize, Model.FeaturedSeries.Count);
    var initialSeriesStatus = Model.FeaturedSeries.Count == 0
        ? "0 of 0"
        : $"1-{initialSeriesEnd} of {Model.FeaturedSeries.Count}";
}

<section class="hero" id="home">
    <div class="hero__media" id="hero-carousel" aria-label="Landing page image carousel">
        @for (var index = 0; index < landingImages.Count; index++)
        {
            var isActive = index == 0 ? "hero__slide--active" : string.Empty;
            <img class="hero__slide @isActive" src="@landingImages[index]" alt="Cinematic photography background @(index + 1)">
        }
        <div class="hero__gradient"></div>
    </div>
    <a class="hero__explore" href="#gallery" aria-label="Explore the gallery">
        <span>Explore</span>
        <span class="material-symbols-outlined" aria-hidden="true">expand_more</span>
    </a>
</section>

<section class="featured-section" id="gallery">
    <div class="lumina-container" data-series-gallery data-series-page-size="@seriesPageSize">
        <div class="section-head reveal">
            <div>
                <h2>Featured Series</h2>
                <p>Curated collections exploring the intersection of structure, nature, and humanity.</p>
            </div>
            <div class="series-toolbar" aria-label="Featured series controls">
                <div class="series-view-toggle" role="group" aria-label="Change series view">
                    <button class="series-view-toggle__button series-view-toggle__button--active" type="button" data-series-view="grid" aria-pressed="true">
                        <span class="material-symbols-outlined" aria-hidden="true">grid_view</span>
                        <span>Grid</span>
                    </button>
                    <button class="series-view-toggle__button" type="button" data-series-view="masonry" aria-pressed="false">
                        <span class="material-symbols-outlined" aria-hidden="true">dashboard</span>
                        <span>Masonry</span>
                    </button>
                </div>
                <a class="soft-button" asp-action="Albums" asp-controller="Home">
                    View Albums
                    <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                </a>
            </div>
        </div>

        <div class="series-grid series-grid--grid" data-series-grid>
            @for (var index = 0; index < Model.FeaturedSeries.Count; index++)
            {
                var series = Model.FeaturedSeries[index];
                var isHidden = index >= seriesPageSize;
                var plainWindow = index == 0 ? string.Empty : " image-window--plain";
                <a class="series-card reveal tilt-card"
                         asp-action="Album"
                         asp-controller="Home"
                         asp-route-id="@series.Id"
                         data-series-card
                         data-series-index="@index"
                         data-series-orientation="@series.Orientation"
                         hidden="@isHidden">
                    <div class="image-window@plainWindow">
                        @if (index == 0)
                        {
                            <div class="window-bar">
                                <span class="traffic traffic--red"></span>
                                <span class="traffic traffic--yellow"></span>
                                <span class="traffic traffic--green"></span>
                                <span class="window-title">Series_01.jpg</span>
                            </div>
                        }
                        <div class="image-window__frame image-window__frame--@series.Orientation">
                            <img src="@series.ImageUrl" alt="@series.ImageAlt">
                        </div>
                    </div>
                    <div class="series-card__copy">
                        <span>@series.Eyebrow</span>
                        <h3>@series.Title</h3>
                        <p>@series.Description</p>
                    </div>
                </a>
            }
        </div>

        <div class="series-pager" data-series-pager>
            <button class="series-pager__button" type="button" data-series-prev disabled>
                <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
                <span>Previous</span>
            </button>
            <span class="series-pager__status" data-series-status aria-live="polite">@initialSeriesStatus</span>
            <button class="series-pager__button" type="button" data-series-next>
                <span>Next</span>
                <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
            </button>
        </div>
    </div>
</section>

<section class="philosophy-section" id="journal">
    <div class="lumina-container">
        <div class="bento-grid">
            <article class="bento-card bento-card--feature reveal">
                <span class="label">Our Philosophy</span>
                <h2>Focusing on the essence, not the clutter.</h2>
                <p>NZO was founded on the principle that photography should be a silent witness. We strip away the unnecessary to reveal the raw, honest beauty of our subjects.</p>
                <div class="established">
                    <span class="established__icon material-symbols-outlined" aria-hidden="true">camera</span>
                    <span>Est. 2012</span>
                </div>
            </article>

            <article class="bento-card bento-card--blue reveal" id="studio">
                <div>
                    <h3>Technical Mastery</h3>
                    <p>Utilizing the latest in optical technology and digital processing to ensure archival quality in every frame.</p>
                </div>
                <span class="material-symbols-outlined bento-card__watermark" aria-hidden="true">settings_suggest</span>
            </article>

            <article class="bento-card bento-card--stat bento-card--dim reveal">
                <strong>24k</strong>
                <span>Moments Captured</span>
            </article>

            <article class="bento-card bento-card--stat reveal">
                <strong>15</strong>
                <span>Global Awards</span>
            </article>
        </div>
    </div>
</section>
