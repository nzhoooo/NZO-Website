@{
    var pageTitle = ViewData["Title"]?.ToString();
    var browserTitle = string.Equals(pageTitle, "NZO", StringComparison.OrdinalIgnoreCase)
        ? "NZO"
        : $"{pageTitle} - NZO";
    var hideSiteChrome = ViewData["HideSiteChrome"] is true;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@browserTitle</title>
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32.png" asp-append-version="true">
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16.png" asp-append-version="true">
    <link rel="icon" href="~/favicon.ico" sizes="any" asp-append-version="true">
    <link rel="apple-touch-icon" sizes="180x180" href="~/favicon-180.png" asp-append-version="true">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
@if (!hideSiteChrome)
{
<nav class="top-bar" id="top-nav" aria-label="Main menu">
    <div class="top-bar__left">
        <a class="top-bar__brand" asp-area="" asp-controller="Home" asp-action="Index">NZO</a>
        <div class="top-bar__menus" aria-label="Studio menu">
            <a class="top-menu__item top-menu__item--active" href="/#home">Home</a>
            <div class="top-menu__group">
                <button class="top-menu__item" type="button" aria-haspopup="true" aria-expanded="false">Gallery</button>
                <div class="top-menu__dropdown" role="menu">
                    <a role="menuitem" href="/#gallery">Main Gallery</a>
                    <a role="menuitem" asp-action="Albums" asp-controller="Home">Albums / Series</a>
                    <a role="menuitem" href="/#archive">Archive</a>
                    <a role="menuitem" href="/#works">Works</a>
                </div>
            </div>
            <div class="top-menu__group">
                <button class="top-menu__item" type="button" aria-haspopup="true" aria-expanded="false">Go</button>
                <div class="top-menu__dropdown" role="menu">
                    <a role="menuitem" href="/#studio">Profile</a>
                    <a role="menuitem" href="/#contact">Contact</a>
                    <a role="menuitem" href="/#services">Services</a>
                    <a role="menuitem" href="/#gear">Gear</a>
                    <a role="menuitem" href="/#pricing">Pricing</a>
                    <a role="menuitem" href="/#credentials">Credentials</a>
                    <a role="menuitem" href="https://www.instagram.com/nzhoooo" target="_blank" rel="noopener noreferrer">Instagram @@nzhoooo</a>
                </div>
            </div>
            <div class="top-menu__group">
                <button class="top-menu__item" type="button" aria-haspopup="true" aria-expanded="false">Window</button>
                <div class="top-menu__dropdown" role="menu">
                    <a role="menuitem" href="/">Guest</a>
                    <button role="menuitem" type="button" data-admin-modal-open>Admin</button>
                </div>
            </div>
            <a class="top-menu__item" asp-area="" asp-controller="Home" asp-action="Help">Help</a>
        </div>
    </div>
    <div class="top-bar__actions">
        <button type="button" aria-label="Search">
            <span class="material-symbols-outlined" aria-hidden="true">search</span>
        </button>
        <button type="button" id="theme-toggle" aria-label="Toggle theme">
            <span class="material-symbols-outlined" aria-hidden="true">dark_mode</span>
        </button>
    </div>
</nav>
}

@if (!hideSiteChrome)
{
<div class="admin-modal" data-admin-modal hidden>
    <div class="admin-modal__backdrop" data-admin-modal-close></div>
    <section class="admin-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="admin-modal-title">
        <button class="admin-modal__close" type="button" aria-label="Close admin password prompt" data-admin-modal-close>
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
        <span class="label">Window</span>
        <h2 id="admin-modal-title">Admin access</h2>
        <form data-admin-password-form>
            <label for="admin-password">Password</label>
            <input id="admin-password" type="password" autocomplete="current-password" data-admin-password-input>
            <p class="admin-modal__error" data-admin-password-error hidden>Incorrect password.</p>
            <button class="soft-button" type="submit">
                Enter admin
                <span class="material-symbols-outlined" aria-hidden="true">login</span>
            </button>
        </form>
    </section>
</div>
}

<main>
    @RenderBody()
</main>

@if (!hideSiteChrome)
{
<footer class="lumina-footer" id="contact">
    <div class="lumina-container lumina-footer__inner">
        <div>
            <span class="lumina-footer__brand">NZO</span>
            <p>&copy; 2024 NZO Studio. Designed for the focused eye.</p>
        </div>
        <div class="lumina-footer__links">
            <a href="#">Privacy</a>
            <a href="#">Terms</a>
            <a href="#">Archive</a>
        </div>
    </div>
</footer>
}

@if (!hideSiteChrome)
{
<nav class="dock" aria-label="Section navigation">
    <a class="dock__item dock__item--active" href="/#home">
        <span class="material-symbols-outlined" aria-hidden="true">home</span>
        <span>Home</span>
    </a>
    <a class="dock__item" href="/#gallery">
        <span class="material-symbols-outlined" aria-hidden="true">photo_library</span>
        <span>Gallery</span>
    </a>
    <a class="dock__item" asp-action="Albums" asp-controller="Home">
        <span class="material-symbols-outlined" aria-hidden="true">collections_bookmark</span>
        <span>Albums</span>
    </a>
    <a class="dock__item" href="/#journal">
        <span class="material-symbols-outlined" aria-hidden="true">auto_stories</span>
        <span>Journal</span>
    </a>
    <a class="dock__item" href="/#studio">
        <span class="material-symbols-outlined" aria-hidden="true">camera</span>
        <span>Studio</span>
    </a>
    <a class="dock__item" href="/#contact">
        <span class="material-symbols-outlined" aria-hidden="true">mail</span>
        <span>Contact</span>
    </a>
</nav>
}

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
